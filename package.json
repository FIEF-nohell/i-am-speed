{
  "name": "i-am-speed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fetch:content": "tsx scripts/fetch-content.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "brand": "tsx scripts/brand/build.ts",
    "check:brand": "tsx scripts/check-brand.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run validate:content && npm run build && npm run check:brand"
  },
  "dependencies": {
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "opentype.js": "^2.0.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "license": "MIT",
  "description": "i am speed: a calm touch-typing trainer for the Austrian QWERTZ keyboard.",
  "engines": {
    "node": ">=20.19"
  }
}
